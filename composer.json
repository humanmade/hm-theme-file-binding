{
	"name": "humanmade/hm-theme-file-binding",
	"description": "Block bindings source that resolves a path in the active theme to a file URL.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Human Made Limited",
			"email": "engineering@humanmade.com"
		}
	],
	"require": {
		"php": ">=8.1",
		"composer/installers": "^1 || ^2"
	},
	"require-dev": {
		"humanmade/coding-standards": "^2.3"
	},
	"scripts": {
		"lint": "phpcs"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
